    hiddenimports=[
        'dotenv',
        'dotenv.main',
        'python_dotenv',
        'openai',
        'requests',
        'requests.adapters',
        'requests.auth',
        'requests.cookies',
        'requests.models',
        'requests.sessions',
        'requests.structures',
        'requests.utils',
        'urllib3',
